# Copy this file to .env (in the folder you run your notebook or script from,
# or any folder above it) and fill in the values. Never commit .env.

# From the app you create in the SKY API developer dashboard:
# https://developer.blackbaud.com/skyapi/apps
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_SUBSCRIPTION_KEY=

# Must exactly match the redirect URI you register for your app.
BB_REDIRECT_URI=http://localhost:8765/callback

# Optional: where Skycart saves your login. Leave blank for ~/.skycart/tokens.json
SKYCART_TOKEN_CACHE=
